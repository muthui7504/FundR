PORT=3001
PUBLIC_APP_URL=https://your-public-app.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
DATABASE_URL=postgresql://fundraise_user:replace-me@localhost:5432/fundraise?schema=public
JWT_SECRET=replace-with-a-long-random-secret
# Generate a persistent 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CREDENTIALS_ENCRYPTION_KEY=
DARAJA_CALLBACK_URL=https://your-public-api.example.com/api/contributions/mpesa/callback

# Optional platform-owned Daraja credentials for organisation subscriptions.
# Leave unset to keep paid subscription checkout disabled.
PLATFORM_DARAJA_CONSUMER_KEY=
PLATFORM_DARAJA_CONSUMER_SECRET=
PLATFORM_DARAJA_SHORTCODE=
PLATFORM_DARAJA_PASSKEY=
PLATFORM_DARAJA_TYPE=PAYBILL
PLATFORM_DARAJA_ENVIRONMENT=SANDBOX
PLATFORM_DARAJA_CALLBACK_URL=https://your-public-api.example.com/api/subscriptions/mpesa/callback

# Optional platform-owned Stripe credentials for campaign card subscriptions.
# Alternatively, configure these in the platform admin dashboard.
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=
